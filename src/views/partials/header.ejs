<body class="grid"> <!-- body end tag in footer -->
    <header class="grid">
        <div class="flex-row">
            <a class="link" id="logo" href="/">
                <img 
                    src="/images/sn-logo93x100.webp" 
                    alt="Server Network Logo"
                    width="93"
                    height="100"
                    loading="eager"
                    fetchpriority="high"
                    title="Home"
                />
            </a>
            <!-- site Name -->
            <span id="site-name" class="center">Service Network</span>
        </div>
        <nav class="center" aria-label="navigation" id="nav-bar">
            <ul class="rmv_liststyle">
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
                <!-- check if a user is logged in, swap nav items if user is logged in or not -->
                <% if (isLoggedIn) { %>
                    <li><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/register">Register</a></li>
                    <li><a href="/login">Login</a></li>
                <% } %>
            </ul>
        </nav>
        <button
            id="ham-btn"
            class="hamburger"
            aria-label="navigation"
            title="Menu"
        ></button>
    </header>
    <% const messages = flash(); %>
        <% Object.keys(messages).forEach(type => { %>
            <% if (messages[type].length > 0) { %>
                
                    <% messages[type].forEach(msg => { %>
                        <div class="alert <%= type %>"><%= msg %></div>
                    <% }); %>
                
            <% } %>
        <% }); %>
