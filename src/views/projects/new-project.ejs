<%- include('../partials/head', { title, keywords, desc}) %>
<%- include('../partials/header') %>
    <main class="grid">
        <h1><%= title %></h1>

        <form action="/new-project" method="POST" class="grid">
            <fieldset class="grid card">

                <label for="title">Project Title
                    <input
                        type="text"
                        id="title"
                        name="title"
                        maxlength="150"
                        required
                    />
                </label>

                <label for="description">Description
                    <textarea
                        id="description"
                        name="description"
                        maxlength="500"
                        required
                    ></textarea>
                </label>


                <label for="location">Location
                    <input
                        type="text"
                        id="location"
                        name="location"
                        maxlength="255"
                        required
                    />
                </label>


                <label for="dateTime">Date
                    <input
                        type="datetime-local"
                        id="dateTime"
                        name="dateTime"
                        required
                    />
                </label>

                <label for="timezone">Time Zone
                    <input
                      type="text"
                      id="timezone"
                      name="timezone"
                      list="timezone-options"
                      value="America/Denver"
                      required
                    />
                    
                    <datalist id="timezone-options">
                        <% timezones.forEach(timezone => { %>
                            <option value="<%= timezone %>"></option>
                        <% }); %>
                    </datalist>
                </label>


                <label for="organizationId">Organization
                    <select
                        id="organizationId"
                        name="organizationId"
                        required
                    >
                        <option value="">Select an organization</option>
                            <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"><%= toTitleCase(org.org_name) %></option>
                        <% }); %>
                    </select>
                </label>
            </fieldset>
            <button class="btn" type="submit">Create Project</button>
        </form>
</main>
<%- include('../partials/footer') %>
