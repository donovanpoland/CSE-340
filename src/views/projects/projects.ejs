<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>
    <main>
        <h1><%= toTitleCase(title)%></h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
                <li class="card">
                        <a href="/project/<%= project.project_id%>">
                            <strong><%= toTitleCase(project.title) %></strong>
                            <br>
                            <%= project.project_datetime %>
                        </a>
                        <div>
                            <span>
                                <a href="/organization/<%= project.organization_id %>">Organized By <%= toTitleCase(project.organization_name) %></a>
                            </span>
                        </div>
                        <div>
                            <span>
                                Located in <%= toTitleCase(project.event_location) %>
                            </span>
                        </div>
                </li>
            <% }); %>
        </ul>
        <p><a href="/new-project">Add a New Service Project</a></p>
    </main>
<%- include('../partials/footer') %>
