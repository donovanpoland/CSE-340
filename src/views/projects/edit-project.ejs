<%- include('../partials/head', { title, keywords, desc}) %>
<%- include('../partials/header') %>
    <main class="grid">
        <h1><%= toTitleCase(title) %></h1>

        <form action="/edit-project/<%= project.project_id %>" method="POST" class="grid">
            <fieldset class="grid card">

                <label for="title">Project Title
                    <input
                        type="text"
                        id="title"
                        name="title"
                        maxlength="150"
                        required
                        value="<%= project.title %>"
                    />
                </label>

                <label for="description">Description
                    <textarea
                        id="description"
                        name="description"
                        maxlength="500"
                        required
                    ><%= project.proj_description %></textarea>
                </label>

                <label for="location">Location
                    <input
                        type="text"
                        id="location"
                        name="location"
                        maxlength="255"
                        required
                        value="<%= project.event_location %>"
                    />
                </label>

                <label for="dateTime">Date
                    <input
                        type="datetime-local"
                        id="dateTime"
                        name="dateTime"
                        required
                        value="<%= project.dateTimeInput %>"
                    />
                </label>

                <label for="timezone">Time Zone
                  <input
                      type="text"
                      id="timezone"
                      name="timezone"
                      list="timezone-options"
                      value="<%= project.project_timezone %>"
                      required
                  />
                  
                  <datalist id="timezone-options">
                      <% timezones.forEach(timezone => { %>
                      <option value="<%= timezone %>"></option>
                      <% }); %>
                  </datalist>
                </label>

                <label for="organizationId">Organization
                    <select
                        id="organizationId"
                        name="organizationId"
                        required
                    >
                        <% organizations.forEach(org => { %>
                            <option
                            value="<%= org.organization_id %>"
                            <%= org.organization_id === project.organization_id ? "selected" : "" %>
                            >
                            <%= toTitleCase(org.org_name) %>
                            </option>
                        <% }); %>
                    </select>
                </label>
                
                <button class="btn" type="submit">Finish Edit</button>
            </fieldset>
        </form>
</main>
<%- include('../partials/footer') %>
