<%- include('partials/head', { title, keywords, desc, categories }) %>
<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <ul class="rmv_liststyle">
            <% categories.forEach(category => { %>
                <li class="card">
                    <div>
                        <span>
                            <strong><%= category.cat_name %></strong>
                        </span>
                    </div>
                    <div>
                        <span>
                            <%= category.cat_description %>
                        </span>
                    </div>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>
