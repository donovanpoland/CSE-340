<%- include('partials/head', { title, keywords, desc }) %>
<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <ul class="rmv_liststyle">
            <% categories.forEach(category => { %>
                <li class="card">
                    <strong><a href="/category/<%= category.category_id %>"><%= category.cat_name %></a></strong>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>
