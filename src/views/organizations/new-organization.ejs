<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>
    <main>
        <h1><%= title %></h1>
        <form action="/new-organization" method="POST" class="grid">
            <fieldset class="grid card">
            
                <label for="name">Organization Name
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                    />
                </label>

                <label for="description">Description
                    <textarea
                        id="description"
                        name="description"
                        required
                        minlength="3"
                        maxlength="150"
                    ></textarea>
                </label>


                <label for="contactEmail">Contact Email
                    <input
                        type="email"
                        id="contactEmail"
                        name="contactEmail"
                        required
                        maxlength="500"
                    />
                </label>

                <button class="btn" type="submit">Create Organization</button>
            </fieldset>
        </form>
    </main>
<%- include('../partials/footer') %>
