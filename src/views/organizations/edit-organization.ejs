<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>
    <main class="grid">
        <h1><%= title %></h1>
        <h2><%= organization.org_name %></h2>
        <p><strong>Organization ID</strong>: <%= organization.organization_id %></p>
        <form action="/edit-organization/<%= organization.organization_id %>" method="POST" class="grid">
            <fieldset class="grid card">
                <label for="name">Organization Name
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        value="<%= organization.org_name %>"
                    />
                </label>


                <label for="description">Description
                    <textarea
                        id="description"
                        name="description"
                        required
                        minlength="3"
                        maxlength="150"
                    ><%= organization.org_description %></textarea>
                </label>

                <label for="contactEmail">Contact Email
                    <input
                        type="email"
                        id="contactEmail"
                        name="contactEmail"
                        required
                        maxlength="500"
                        value="<%= organization.contact_email %>"
                    />
                </label>

                <button class="btn" type="submit">Finish Edit</button>
            </fieldset>
        </form>
    </main>
<%- include('../partials/footer') %>
