<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>
    <main class="grid">
        <h1><%= title %></h1>
        <h2><%= category.cat_name %></h2>
        <p><strong>Category ID</strong>: <%= category.category_id %></p>
        <form action="/edit-category/<%= category.category_id %>" method="POST" class="grid">
            <fieldset class="grid card">

                <label for="name">Category Name
                    <input 
                        type="text" 
                        name="name" 
                        id="name"
                        required
                        maxlength="100"
                        value="<%= category.cat_name %>">
                </label>

                <label for="description">Description
                    <textarea
                        id="description"
                        name="description"
                        required
                        minlength="3"
                        maxlength="500"
                    ><%= category.cat_description %></textarea>
                </label>

                <button class="btn" type="submit" id="submit">Finish Edit</button>
            </fieldset>
        </form>
    </main>
<%- include('../partials/footer') %>