<%- include('../partials/head', { title, keywords, desc}) %>
<%- include('../partials/header') %>
    <main class="grid">
        <div class="flex-row">
            <h1><%= toTitleCase(title) %></h1>
            <% if (user && user.role_name === 'admin') { %>
                <p class="center">- <strong>Admin</strong></p>
                <a class="btn" href="/edit-category/<%= category.category_id %>">Edit Category</a>
            <% } %>
        </div>
        <section>
            <h2><%= toTitleCase(category.cat_name) %></h2>
            <p class="indent"><%= capitalizeFirstLetter(category.cat_description) %></p>
        </section>

        <section>
            <h3>Related Projects</h3>
            <ul class="grid">
                <% projects.forEach(project => { %>
                    <li>
                        <a class="link" href="/project/<%= project.project_id %>"><%= toTitleCase(project.title) %></a>
                    </li>
                <% }) %>
            </ul>     
        </section>
    </main>
<%- include('../partials/footer') %>
