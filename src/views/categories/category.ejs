<%- include('../partials/head', { title, keywords, desc}) %>
<%- include('../partials/header') %>
    <main class="grid">
        <h1><%= toTitleCase(category.cat_name) %></h1>
        <p><%= capitalizeFirstLetter(category.cat_description) %></p>

        <h2>Related Projects</h2>
        <ul class="grid rmv_liststyle">
            <% projects.forEach(project => { %>
                <li class="card">
                    <a class="link" href="/project/<%= project.project_id %>"><%= toTitleCase(project.title) %></a>
                </li>
            <% }) %>
        </ul>
        <a class="btn" href="/edit-category/<%= category.category_id %>">Edit Category</a>
    </main>
<%- include('../partials/footer') %>
