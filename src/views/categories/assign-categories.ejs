<%- include('../partials/head', { title, keywords, desc}) %>
<%- include('../partials/header') %>
  <main class="grid">
    <h1><%= toTitleCase(project.title) %></h1>

    <h2>Assign Categories</h2>
    <form action="/assign-categories/<%= projectId %>" method="POST" class="grid">
      <fieldset class="grid card">
        <div class="flex-column">
          <% categories.forEach(category => { %>
            <label id="checkbox-label" for="category-<%= category.category_id %>"><%= toTitleCase(category.cat_name) %>
              <input
                type="checkbox"
                id="category-<%= category.category_id %>"
                name="categoryIds"
                value="<%= category.category_id %>"
                <%= assignedCategories.some(ac => ac.category_id === category.category_id) ? 'checked' : '' %>
              />
            </label>
          <% }); %>
        </div>
        <button class="btn" type="submit">Update Categories</button>
      </fieldset>
    </form>
  </main>
<%- include('../partials/footer') %>
