<%- include('partials/head', { title, keywords, desc }) %>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2><%= organizationDetails.org_name %></h2>
    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.org_name %> logo">

    <p><strong>Description</strong>: <%= organizationDetails.org_description %></p>

    <h3>Service Projects</h3>
    <ul class="rmv_liststyle">
        <% projects.forEach(project => { %>
        <li class="card"><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>