<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>
    <main>
        <h1><%= title %></h1>
        <form action="/register" method="POST" class="grid">
            <fieldset class="grid card">
            
                <label for="fname">First Name
                    <input 
                        type="text" 
                        name="fname" 
                        id="fname"
                        maxlength="100"
                        autocomplete="given-name"
                        required
                        >
                </label>

                <label for="lname">Last Name
                    <input 
                        type="text" 
                        name="lname" 
                        id="lname"
                        maxlength="100"
                        autocomplete="family-name"
                        required
                        >
                </label>

                <label for="email">Email
                    <input 
                    type="email"
                    id="email"
                    name="email"
                    autocomplete="email"
                    maxlength="255"
                    required
                    >
                </label>

                <label for="password">Password
                    <input 
                    type="password"
                    id="password"
                    name="password"
                    minlength="7"
                    maxlength="72"
                    required
                    >
                </label>

                <label for="confirmPassword">Confirm Password
                    <input 
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    minlength="7"
                    maxlength="72"
                    required
                    >
                </label>

                <label for="organizationId">Organization (optional)
                    <select
                        id="organizationId"
                        name="organizationId"
                    >
                        <option value="">Select an organization</option>
                            <% organizations.forEach(org => { %>
                        <option value="<%= org.organization_id %>"><%= toTitleCase(org.org_name) %></option>
                        <% }); %>
                    </select>
                </label>
                

                <button class="btn" type="submit" id="submit">Register</button>
            </fieldset>
        </form>
    </main>
<%- include('../partials/footer') %>