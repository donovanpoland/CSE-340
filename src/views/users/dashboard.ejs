<%- include('../partials/head', { title, keywords, desc }) %>
<%- include('../partials/header') %>

<main class="grid">
    <h1><%= toTitleCase(title) %></h1>

    <section class="grid">
        <h2>Account info</h2>
        <p>Name: <%= capitalizeFirstLetter(user.first_name) %> <%= capitalizeFirstLetter(user.last_name) %></p>
        <p>Username: <%= user.user_email %></p>
        <p>Permissions: <%= user.role_name %></p>
    </section>
    

</main>

<%- include('../partials/footer') %>