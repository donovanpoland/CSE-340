<%- include('partials/head', { title, keywords, desc}) %>
<%- include('partials/header') %>
    <main>
        <h1><%= toTitleCase(title) %></h1>
        <ul class="rmv_liststyle">
            <li><strong>Description</strong>: <%= capitalizeFirstLetter(project.proj_description) %></li>
            <li><strong>When</strong>: <%= project.project_datetime %></li>
            <li><strong>Location</strong>: <%= toTitleCase(project.event_location) %></li>
            <li><strong>Organized By: </strong><a href="/organization/<%= project.organization_id %>"><%= toTitleCase(project.organization_name) %></a></li>
            <li><strong>Categories</strong>:</li>
            <% categories.forEach(category => { %>
                <li>- <a href="/category/<%= category.category_id %>"><%= toTitleCase(category.cat_name) %></a></li>
            <% }); %>
        </ul>
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    </main>
<%- include('partials/footer') %>